# Required for SEC EDGAR fair-access policy: identify your app and real contact.
# Copy to .env and replace the placeholder before running `vp run dev`.
SEC_USER_AGENT="Matrix YOUR_REAL_CONTACT_EMAIL"

# Matrix stores application state and its successful SEC responses locally.
# MATRIX_HOME=/absolute/path/to/matrix-state
# MATRIX_DATA_CACHE_DIR=/absolute/path/to/sec-cache

# The launcher creates a private random daemon token and loopback port per run.
# No SEC API key is needed. Do not put model keys in VITE_* variables.
# MATRIX_DATA_BIN=/absolute/path/to/prebuilt/matrix-data

# Upstream T3 Connect/Clerk/telemetry production configuration is intentionally
# absent. Matrix runs locally without signing into upstream hosted services.
